# ========= VIS + S3 SAVE =========

def draw_boxes(frame: np.ndarray, detections):
    for det in detections:
        x1, y1, x2, y2 = map(int, det["box"])
        cls = det["class"]
        score = det["score"]

        cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
        label = f"{cls} {score:.2f}"
        cv2.putText(frame, label, (x1, max(0, y1 - 10)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 1)
    return frame


def save_frame_to_s3(frame: np.ndarray, match_id: str, frame_id: int) -> str:
    ok, jpeg = cv2.imencode(".jpg", frame)
    if not ok:
        raise RuntimeError("JPEG encoding failed")

    key = f"processed/{match_id}/frame_{frame_id:06d}.jpg"
    s3.put_object(
        Bucket=DEST_BUCKET,
        Key=key,
        Body=jpeg.tobytes(),
        ContentType="image/jpeg",
    )
    return key


# ========= KINESIS CONSUMER LOOP =========

def main():
    # Get first shard
    shards_resp = kinesis.list_shards(StreamName=KINESIS_STREAM_NAME)
    shards = shards_resp.get("Shards", [])
    if not shards:
        print("No shards found on stream", KINESIS_STREAM_NAME)
        return

    shard_id = shards[0]["ShardId"]
    print("Using shard:", shard_id)

    it_resp = kinesis.get_shard_iterator(
        StreamName=KINESIS_STREAM_NAME,
        ShardId=shard_id,
        ShardIteratorType="TRIM_HORIZON",  # or 'LATEST'
    )
    shard_it = it_resp["ShardIterator"]

    print("Starting EC2 GPU consumer loop...")
    while True:
        resp = kinesis.get_records(ShardIterator=shard_it, Limit=25)
        shard_it = resp["NextShardIterator"]
        records = resp["Records"]

        for r in records:
            try:
                payload = json.loads(r["Data"])
                match_id = payload["match_id"]
                frame_id = payload["frame_id"]
                frame_b64 = payload["image_jpg_b64"]

                jpeg_bytes = base64.b64decode(frame_b64)
                np_arr = np.frombuffer(jpeg_bytes, dtype=np.uint8)
                frame = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)

                if frame is None:
                    print(f"[WARN] Failed to decode frame {frame_id} for match {match_id}")
                    continue

                # Run SAM3
                detections = run_sam3(frame)

                # Store detections to DB
                for det in detections:
                    cls = det["class"]
                    score = det["score"]
                    x1, y1, x2, y2 = det["box"]
                    insert_detection(match_id, frame_id, cls, score, x1, y1, x2, y2)

                # Save annotated frame to S3
                annotated = draw_boxes(frame.copy(), detections)
                key = save_frame_to_s3(annotated, match_id, frame_id)

                print(f"[OK] frame={frame_id} match={match_id} saved={key} detections={len(detections)}")

            except Exception as e:
                print(f"[ERROR] processing record: {e}")

        time.sleep(0.2)


if __name__ == "__main__":
    main()
