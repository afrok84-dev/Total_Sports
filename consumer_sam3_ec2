import os
import json
import time
import base64

import boto3
import numpy as np
import cv2
import psycopg2

# ========= ENV CONFIG =========
AWS_REGION = os.getenv("AWS_REGION", "eu-central-1")
KINESIS_STREAM_NAME = os.getenv("KINESIS_STREAM_NAME", "kinesis_sportsvid_datastream")
DEST_BUCKET = os.getenv("DEST_BUCKET", "football-mvp-storage")  # where to store processed frames
DB_URL = os.getenv("DB_URL")  # cloud-accessible Postgres

# AWS clients (use EC2 IAM role instead of access keys if possible)
kinesis = boto3.client("kinesis", region_name=AWS_REGION)
s3 = boto3.client("s3", region_name=AWS_REGION)

# ========= DB CONNECTION HELPERS =========
_db_conn = None

def get_db_conn():
    global _db_conn
    if _db_conn is None or _db_conn.closed != 0:
        _db_conn = psycopg2.connect(DB_URL)
    return _db_conn


def insert_detection(match_id, frame_id, cls, score, x1, y1, x2, y2):
    conn = get_db_conn()
    cur = conn.cursor()
    cur.execute(
        """
        INSERT INTO detections
        (match_id, frame_id, class, score, x1, y1, x2, y2)
        VALUES (%s,%s,%s,%s,%s,%s,%s,%s)
        """,
        (match_id, frame_id, cls, score, x1, y1, x2, y2),
    )
    conn.commit()
    cur.close()


