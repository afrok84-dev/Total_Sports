import os
import json
import base64
import uuid
from io import BytesIO

import boto3
import psycopg2
import numpy as np
import cv2

# ========= ENV CONFIG =========
AWS_REGION = os.getenv("AWS_REGION", "eu-central-1")
DEST_BUCKET = os.getenv("DEST_BUCKET", "football-mvp-storage")  # processed images bucket
DB_URL = os.getenv("DB_URL")

KINESIS_STREAM_NAME = os.getenv("KINESIS_STREAM_NAME", "kinesis_sportsvid_datastream")

s3_client = boto3.client("s3", region_name=AWS_REGION)


# ========= DB CONNECTION SETUP =========
# For Lambdas, it's common to create a global connection and reuse it across invocations.
db_conn = None


def get_db_conn():
    global db_conn
    if db_conn is None or db_conn.closed != 0:
        db_conn = psycopg2.connect(DB_URL)
    return db_conn


def insert_detection(match_id, frame_id, cls, score, x1, y1, x2, y2):
    conn = get_db_conn()
    cur = conn.cursor()
    cur.execute(
        """
        INSERT INTO detections (match_id, frame_id, class, score, x1, y1, x2, y2)
        VALUES (%s,%s,%s,%s,%s,%s,%s,%s)
        """,
        (match_id, frame_id, cls, score, x1, y1, x2, y2),
    )
    conn.commit()
    cur.close()


# ========= SAM3 STUB =========
